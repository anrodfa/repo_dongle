/*
 * Dongle del Corne: un nRF52840 (clon de nice!nano) enchufado por USB de forma
 * permanente. No tiene teclas ni sensores propios; su unico trabajo es ser la
 * central del split y hablar HID con el ordenador.
 *
 * 1. kscan mock (0 filas, 0 columnas). ZMK exige un kscan elegido, pero aqui no
 *    hay matriz que escanear: las pulsaciones llegan por BLE desde las mitades.
 *
 * 2. Los physical layouts del Corne, IDENTICOS a los de las mitades. Esto es
 *    critico y es donde fallo la primera version: declaraba solo el layout de 6
 *    columnas, mientras que las mitades (via corne.dtsi) declaran los dos, el
 *    de 5 y el de 6, en ese orden. Resultado: el dongle interpretaba las
 *    posiciones que le mandaban las mitades corridas un lugar, y salia ESC
 *    donde tocaba Q.
 *
 *    Por eso esto es copia literal de la parte de layouts y transformaciones de
 *    app/boards/shields/corne/corne.dtsi, quitando solo el kscan de matriz y el
 *    OLED, que aqui no aplican. Si cambia alli, hay que sincronizarlo.
 *
 *    Nota: el teclado es fisicamente de 5 columnas, pero el keymap declara 6 y
 *    el layout elegido es el de 6 (igual que en las mitades). La columna
 *    exterior simplemente no esta cableada, y por eso ESC/TAB/BSPC se generan
 *    con combos. No hay que "arreglar" eso: es como siempre ha funcionado.
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include <layouts/foostan/corne/5column.dtsi>
#include <layouts/foostan/corne/6column.dtsi>

&foostan_corne_6col_layout {
    transform = <&default_transform>;
};

&foostan_corne_5col_layout {
    transform = <&five_column_transform>;
};

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &foostan_corne_6col_layout;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    five_column_transform: keymap_transform_1 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };
};
